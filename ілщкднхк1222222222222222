local function makeSlider(page, title, min, max, default, decimals, onChange)
	local m = 10 ^ decimals

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -8, 0, 68)
	row.BackgroundColor3 = COLORS.card
	row.BackgroundTransparency = T.card
	row.BorderSizePixel = 0
	row.LayoutOrder = nextOrder(page)
	row.Parent = page
	round(row, 12)

	label(row, title, 15, Enum.Font.GothamBold, COLORS.text, 14, 10, 180, 22)
	local valueLabel = label(row, tostring(default), 13, Enum.Font.GothamBold, COLORS.sub, 0, 10, 60, 22, Enum.TextXAlignment.Right)
	valueLabel.Position = UDim2.new(1, -74, 0, 10)

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, -28, 0, 24)
	hit.Position = UDim2.new(0, 14, 0, 36)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.AutoButtonColor = false
	hit.Parent = row

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 6)
	track.Position = UDim2.new(0, 0, 0.5, -3)
	track.BackgroundColor3 = COLORS.off
	track.BorderSizePixel = 0
	track.Parent = hit
	round(track, 3)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	fill.BorderSizePixel = 0
	fill.Parent = track
	round(fill, 3)
	gradient(fill, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 16, 0, 16)
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.BackgroundColor3 = Color3.new(1, 1, 1)
	knob.BorderSizePixel = 0
	knob.Parent = hit
	round(knob, 8)

	local function render(r)
		fill.Size = UDim2.new(r, 0, 1, 0)
		knob.Position = UDim2.new(r, 0, 0.5, 0)
	end

	local function setValue(v)
		render(math.clamp((v - min) / (max - min), 0, 1))
		valueLabel.Text = tostring(math.floor(v * m + 0.5) / m)
	end
	setValue(default)

	local dragging = false
	local function update(x)
		local r = math.clamp((x - hit.AbsolutePosition.X) / hit.AbsoluteSize.X, 0, 1)
		render(r)
		local v = min + r * (max - min)
		v = math.floor(v * m + 0.5) / m
		valueLabel.Text = tostring(v)
		onChange(v)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			update(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			update(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	return setValue
end

