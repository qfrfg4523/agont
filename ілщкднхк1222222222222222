local function setOpen(state)
	isOpen = state
	openButton.Visible = not state
	if state then
		scale.Scale = 0.85
		menu.Visible = true
		TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
	else
		local p = menu.Position
		openButton.Position = UDim2.new(p.X.Scale, p.X.Offset + W - 49, p.Y.Scale, p.Y.Offset)
		local t = TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.85})
		t.Completed:Connect(function()
			if not isOpen then
				menu.Visible = false
			end
		end)
		t:Play()
	end
end

