local function makeFpsRow(page)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -8, 0, 62)
	row.BackgroundColor3 = COLORS.card
	row.BackgroundTransparency = T.card
	row.BorderSizePixel = 0
	row.LayoutOrder = nextOrder(page)
	row.Parent = page
	round(row, 12)

	label(row, "Показатель FPS", 15, Enum.Font.GothamBold, COLORS.text, 14, 11, 190, 22)
	label(row, "Обновляется каждые полсекунды", 12, Enum.Font.Gotham, COLORS.sub, 14, 33, 220, 18)

	local value = label(row, "--", 24, Enum.Font.GothamBlack, COLORS.fpsGood, 0, 0, 70, 62, Enum.TextXAlignment.Right)
	value.Position = UDim2.new(1, -84, 0, 0)

	local frames = 0
	local last = os.clock()

	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		if not menu.Visible then
			frames = 0
			last = now
			return
		end
		frames += 1
		if now - last >= 0.5 then
			local fps = math.floor(frames / (now - last) + 0.5)
			value.Text = tostring(fps)
			if fps >= 50 then
				value.TextColor3 = COLORS.fpsGood
			elseif fps >= 30 then
				value.TextColor3 = COLORS.fpsMid
			else
				value.TextColor3 = COLORS.fpsBad
			end
			frames = 0
			last = now
		end
	end)
end

-- Подсветка и ники
local function updatePlayer(player)
	if player == localPlayer then
		return
	end
	local character = player.Character

	if hlOn and character then
		local h = highlights[player]
		if not h or h.Parent ~= character then
			if h then
				h:Destroy()
			end
			h = Instance.new("Highlight")
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Adornee = character
			h.Parent = character
			highlights[player] = h
		end
		h.FillColor = hlColor
		h.OutlineColor = hlColor
		h.FillTransparency = hlTransparency
	elseif highlights[player] then
		highlights[player]:Destroy()
		highlights[player] = nil
	end

	local head = character and character:FindFirstChild("Head")
	if tagsOn and head then
		local tag = nameTags[player]
		if not tag or tag.Parent ~= head then
			if tag then
				tag:Destroy()
			end
			tag = Instance.new("BillboardGui")
			tag.Name = "NameTag"
			tag.Size = UDim2.new(0, 160, 0, 26)
			tag.StudsOffset = Vector3.new(0, 2.6, 0)
			tag.AlwaysOnTop = true
			tag.MaxDistance = math.huge
			tag.Adornee = head
			tag.Parent = head

			local l = Instance.new("TextLabel")
			l.Size = UDim2.new(1, 0, 1, 0)
			l.BackgroundTransparency = 1
			l.Text = player.Name
			l.TextColor3 = Color3.new(1, 1, 1)
			l.TextStrokeColor3 = Color3.new(0, 0, 0)
			l.TextStrokeTransparency = 0.2
			l.Font = Enum.Font.GothamBold
			l.TextSize = 16
			l.Parent = tag

			nameTags[player] = tag
		end
	elseif nameTags[player] then
		nameTags[player]:Destroy()
		nameTags[player] = nil
	end
end

local function refreshAll()
	for _, player in ipairs(Players:GetPlayers()) do
		updatePlayer(player)
	end
end

local function clearPlayer(player)
	if highlights[player] then
		highlights[player]:Destroy()
		highlights[player] = nil
	end
	if nameTags[player] then
		nameTags[player]:Destroy()
		nameTags[player] = nil
	end
end

local function trackPlayer(player)
	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 5)
		task.wait(0.1)
		updatePlayer(player)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	trackPlayer(player)
end
Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(clearPlayer)

-- Небо
local originalSky = Lighting:FindFirstChildOfClass("Sky")
local originalAtmo = Lighting:FindFirstChildOfClass("Atmosphere")
local original = {
	time = Lighting.ClockTime,
	ambient = Lighting.Ambient,
	outdoor = Lighting.OutdoorAmbient,
}

local presetSky, presetAtmo, presetCC
local timeSet = function() end

local function clearPresets()
	if presetSky then
		presetSky:Destroy()
		presetSky = nil
	end
	if presetAtmo then
		presetAtmo:Destroy()
		presetAtmo = nil
	end
	if presetCC then
		presetCC:Destroy()
		presetCC = nil
	end
end

local function restoreOriginals()
	if originalSky then
		originalSky.Parent = Lighting
	end
	if originalAtmo then
		originalAtmo.Parent = Lighting
	end
	Lighting.Ambient = original.ambient
	Lighting.OutdoorAmbient = original.outdoor
end

local function hideOriginals()
	if originalSky then
		originalSky.Parent = nil
	end
	if originalAtmo then
		originalAtmo.Parent = nil
	end
end

local function applySky(index)
	local s = SKIES[index]

	clearPresets()

	if s.default then
		restoreOriginals()
		Lighting.ClockTime = original.time
		timeSet(original.time)
		return
	end

	hideOriginals()

	presetSky = Instance.new("Sky")
	presetSky.StarCount = s.stars
	presetSky.CelestialBodiesShown = not s.black
	if s.black then
		presetSky.SkyboxBk = ""
		presetSky.SkyboxDn = ""
		presetSky.SkyboxFt = ""
		presetSky.SkyboxLf = ""
		presetSky.SkyboxRt = ""
		presetSky.SkyboxUp = ""
	end
	presetSky.Parent = Lighting

	if s.atmo then
		presetAtmo = Instance.new("Atmosphere")
		presetAtmo.Density = s.atmo.density
		presetAtmo.Offset = s.atmo.offset
		presetAtmo.Color = s.atmo.color
		presetAtmo.Decay = s.atmo.decay
		presetAtmo.Glare = s.atmo.glare
		presetAtmo.Haze = s.atmo.haze
		presetAtmo.Parent = Lighting
	end

	presetCC = Instance.new("ColorCorrectionEffect")
	presetCC.TintColor = s.tint
	presetCC.Saturation = s.saturation
	presetCC.Parent = Lighting

	Lighting.Ambient = s.ambient
	Lighting.OutdoorAmbient = s.outdoor
	Lighting.ClockTime = s.time
	timeSet(s.time)
end

